{
  "name": "palette-functions",
  "description": "Cloud Functions for palette by vixxiv — Square billing + subscription lifecycle",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "setup:plans": "tsx src/setupPlans.ts",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2",
    "square": "^37.1.1"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
