# Non-secret Square config for Cloud Functions.
# Copy to functions/.env and fill in. (Secrets are NOT stored here — see below.)

# "sandbox" while testing, "production" when charging real cards.
SQUARE_ENVIRONMENT=sandbox

# Your Square Location ID (Square Dashboard → Account & Settings → Locations).
SQUARE_LOCATION_ID=

# Plan variation IDs printed by `npm run setup:plans`.
SQUARE_PLAN_MONTHLY=
SQUARE_PLAN_ANNUAL=

# One-time lifetime price, in cents.
LIFETIME_PRICE_CENTS=5000

# Public URL the squareWebhook function is deployed at — must match exactly
# what you register in the Square Developer dashboard (used to verify signatures).
# Example: https://us-central1-<project-id>.cloudfunctions.net/squareWebhook
SQUARE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# SECRETS — do NOT put these here. Set them with the Firebase CLI instead:
#   firebase functions:secrets:set SQUARE_ACCESS_TOKEN
#   firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY
# ---------------------------------------------------------------------------

# List prices in cents (promo maths and reverting first-payment promos)
PRICE_MONTHLY_CENTS=500
PRICE_ANNUAL_CENTS=2500
# Comma-separated sign-in emails allowed into /admin
ADMIN_EMAILS=joe@vixxiv.com,amvp123@gmail.com

# Brevo (CRM + transactional email). The API key is the BREVO_API_KEY secret.
BREVO_SENDER_EMAIL=palette@vixxiv.com
BREVO_SENDER_NAME=palette by vixxiv
BREVO_REPLY_TO=contact@vixxiv.com
# Brevo list ids: paying or comped members, accounts that never paid, lapsed members
BREVO_LIST_SUBSCRIBERS=8
BREVO_LIST_NON_SUBSCRIBERS=9
BREVO_LIST_FORMER=10
