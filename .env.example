# Copy this file to .env.local and fill in values.
# Anything prefixed with VITE_ is bundled into the browser build (publishable
# values only — never put secret keys here).

# --- Gemini (optional, existing) -------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- vixxiv-id identity hub ------------------------------------------------
# Hub sign-in page. Defaults to https://auth.vixxiv.com/ (ADR-0001 D3).
# Until auth.vixxiv.com DNS exists: https://vixxiv-id-auth.web.app/
VITE_HUB_SIGN_IN_URL=""
# Where membership is sold (vixxiv.com Tools page — URL not decided yet).
VITE_MEMBERSHIP_URL=""
# "1" = use the local Firebase emulators (Auth 9399, Firestore 8085).
VITE_USE_EMULATORS=""

# The Firebase web config lives in firebase-applet-config.json and points at
# vixxiv-id. palette has no billing configuration: the hub owns Square.
