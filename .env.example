# Copy this file to .env.local and fill in real values.
# Anything prefixed with VITE_ is bundled into the browser build (publishable
# values only — never put secret keys here).

# --- Gemini (optional, existing) -------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Square Web Payments SDK (frontend, publishable) -----------------------
# From the Square Developer Dashboard → your application → Credentials.
VITE_SQUARE_APP_ID=""
VITE_SQUARE_LOCATION_ID=""
# "sandbox" while testing, "production" to take real cards.
VITE_SQUARE_ENV="sandbox"

# NOTE: The Firebase web config lives in firebase-applet-config.json
# (populated by `firebase apps:sdkconfig web`), not in this file.
