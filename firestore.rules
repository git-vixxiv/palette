rules_version = '2';

// palette — rules for the NAMED Firestore database `palette` in vixxiv-id.
// (ADR-0001 Brief 2: "move data to a named Firestore database ... inside
// vixxiv-id".) These rules never apply to the hub's (default) database; the
// hub's own rules live in git-vixxiv/vixxiv-id and palette does not edit them.
//
// Entitlement is read from the vixxiv-id ID token's custom claims, set by the
// hub's syncCustomClaims: tool access = client == true OR tier in {gold, black}
// (ADR-0001 D4; hub functions/src/tiers.ts unlocksTools). Access stops the
// moment the claim drops (R8): a lapsed member can neither read nor write their
// palettes. The documents are retained until the hub's purge queue tells
// palette's purge worker to delete them (ADR-0001 §10 gap 4).

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasTools() {
      return isSignedIn() && (
        request.auth.token.get('client', false) == true
        || request.auth.token.get('tier', 'none') in ['gold', 'black']
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPalette(data) {
      return data.keys().hasOnly(['userId', 'name', 'harmonyMode', 'colors', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && data.harmonyMode is string && data.harmonyMode.size() <= 32
        && data.colors is list && data.colors.size() >= 3 && data.colors.size() <= 10;
    }

    match /palettes/{paletteId} {
      allow get: if hasTools() && isOwner(existing().userId);

      // Lists must be scoped to the caller's own userId.
      allow list: if hasTools() && resource.data.userId == request.auth.uid;

      allow create: if hasTools()
        && isValidId(paletteId)
        && isOwner(incoming().userId)
        && isValidPalette(incoming())
        && incoming().createdAt == request.time;

      allow update: if hasTools()
        && isValidId(paletteId)
        && isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidPalette(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if hasTools() && isOwner(existing().userId);
    }
  }
}
