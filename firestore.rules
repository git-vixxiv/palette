rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Globally Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Enforce schema validation for a color palette
    function isValidPalette(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && data.harmonyMode is string && data.harmonyMode.size() <= 32
        && data.colors is list && data.colors.size() >= 2 && data.colors.size() <= 10;
    }

    // Enforce schema validation for a user subscription profile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.tier is string && (data.tier == 'free' || data.tier == 'pro-monthly' || data.tier == 'pro-annual' || data.tier == 'pro-lifetime')
        && (data.email is string ? (data.email.size() <= 256) : true);
    }

    // Billing-controlled fields may ONLY be written by the trusted backend
    // (Cloud Functions via the Admin SDK bypass these rules). The client is
    // never allowed to set or change these, which prevents a user from
    // self-granting a paid tier from the browser console.
    function billingFieldsUnchanged(incomingData, existingData) {
      return incomingData.tier == existingData.tier
        && incomingData.get('subscriptionId', '') == existingData.get('subscriptionId', '')
        && incomingData.get('subscriptionStatus', '') == existingData.get('subscriptionStatus', '')
        && incomingData.get('premiumExpires', '') == existingData.get('premiumExpires', '')
        && incomingData.get('premiumExpiresAt', null) == existingData.get('premiumExpiresAt', null)
        && incomingData.get('squareCustomerId', '') == existingData.get('squareCustomerId', '')
        && incomingData.get('pricingPlan', '') == existingData.get('pricingPlan', '');
    }

    // Server-side view of "does this signed-in user currently have Pro?".
    // Reads the profile the backend maintains. Monthly/annual plans stay
    // valid until premiumExpiresAt plus a 3-day grace period (covers payment
    // retries and webhook delay); lifetime never lapses.
    function hasProAccess() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.tier == 'pro-lifetime'
        || ((profile.tier == 'pro-monthly' || profile.tier == 'pro-annual')
            && profile.get('premiumExpiresAt', null) != null
            && request.time < profile.premiumExpiresAt + duration.value(3, 'd'));
    }

    // Free accounts get exactly two palette slots with fixed document IDs, so
    // the 2-palette cap is enforced here and cannot be bypassed from the
    // browser. Pro accounts may create palettes under any valid ID.
    function isFreePaletteSlot(paletteId) {
      return paletteId == request.auth.uid + '_slot1'
        || paletteId == request.auth.uid + '_slot2';
    }

    // On first profile creation the client may only ever start on the free tier
    // with no active subscription metadata.
    function isCleanFreeProfile(data) {
      return data.tier == 'free'
        && data.get('subscriptionStatus', '') != 'active'
        && data.get('subscriptionId', '') == ''
        && data.get('pricingPlan', '') == '';
    }

    // 3. Match Block for User Saved Palettes
    match /palettes/{paletteId} {
      
      allow get: if isSignedIn() && isOwner(existing().userId);
      
      // Query Enforcer: Lists must be scoped to the authenticated user's ID
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() 
        && isValidId(paletteId)
        && isOwner(incoming().userId)
        && isValidPalette(incoming())
        && incoming().createdAt == request.time
        && (isFreePaletteSlot(paletteId) || hasProAccess());

      allow update: if isSignedIn()
        && isValidId(paletteId)
        && isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidPalette(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn() 
        && isOwner(existing().userId);
    }

    // 4. Match Block for User Profiles & Billing Tiers
    //
    // IMPORTANT: tier / subscription fields are granted by the backend only.
    // The client may create its own profile on the free tier and edit
    // non-billing fields, but can never elevate its own tier. All paid-tier
    // writes happen in Cloud Functions through the Admin SDK, which is not
    // subject to these rules.
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);

      // Client may only ever create a clean, free-tier profile for itself.
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && isCleanFreeProfile(incoming())
        && incoming().updatedAt == request.time;

      // Client may update non-billing fields, but the billing fields must be
      // identical to what is already stored (only the backend can change them).
      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && billingFieldsUnchanged(incoming(), existing())
        && incoming().updatedAt == request.time;

      allow delete: if false; // Profiles are read/write but non-deletable from the client
    }
  }
}
